{
  "permissions": {
    "allow": [
      "Bash(npx fallow *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(.venv/bin/*)",
      "Bash(docker compose *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -qE '\\.(ts|tsx)$' && npx tsc -b 2>&1 | head -40 || true",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hook-issue-assign.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
