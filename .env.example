# --- Database -------------------------------------------------------------------
# Host-side URL for running Flask without Docker. Inside Compose the backend uses
# postgresql://app:app@db:5432/app (set in docker-compose.yml).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- Flask ----------------------------------------------------------------------
# Anything but "development" refuses to start with a placeholder SECRET_KEY.
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
SECRET_KEY=change-me-in-production
# Resolved to an absolute path; Docker mounts the uploads_data volume here.
UPLOAD_FOLDER=src_back/uploads

# --- Seed -----------------------------------------------------------------------
# src_back/seed.py runs on every backend start and creates the first admin from these.
# It skips when either is blank, an admin already exists, or the email already has an
# account, and never changes an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS -----------------------------------------------------------------------
# Comma-separated allowed frontend origins. "*" permits all (dev only): it also lets any
# site pass the CORS preflight for X-Requested-With, voiding the CSRF header check
# (ai/conventions.md), so production lists only its own origin.
CORS_ALLOWED_ORIGINS=*

# --- Session cookies ------------------------------------------------------------
# Set SECURE=true and SAMESITE=Strict in production behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- Ports and Compose project --------------------------------------------------
# scripts/up.sh bumps any port already in use and writes the result back here.
# scripts/worktree-setup.sh shifts all three ports and the project name so sibling
# worktrees can run full stacks side by side.
COMPOSE_PROJECT_NAME=flask-react-template
DB_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=5174
VITE_API_URL=http://localhost:5000

# --- Public origin and passkey name ---------------------------------------------
# The origin browsers use: scheme, host, and port, with no path. OAuth redirect URIs
# and the WebAuthn origin are built from it, never from the request. scripts/up.sh
# moves a blank or localhost value to FRONTEND_PORT, scripts/worktree-setup.sh sets
# it per worktree, and scripts/provision.sh writes https://$DOMAIN on the server.
# Blank outside development, it disables OAuth sign-in and passkeys.
PUBLIC_BASE_URL=http://localhost:5174
# Site name in passkey prompts. Blank falls back to APP_NAME.
WEBAUTHN_RP_NAME=

# --- Production only (docker/docker-compose.prod.yml, scripts/deploy.sh) --------
# APP_NAME names the clone under $HOME on the server, the nginx site, the log and
# backup directories, and the systemd units. DOMAIN is the public hostname.
APP_NAME=flask-react-template
DOMAIN=
# Let's Encrypt registration address for scripts/certbot-setup.sh (or pass --email).
CERTBOT_EMAIL=
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
GUNICORN_WORKERS=4
# Loopback port the frontend container publishes; host nginx proxies to it.
FRONTEND_HOST_PORT=8080

# Operational alerts (scripts/alert.sh): failed backups and restore drills, failed
# certbot renewals, certificates near expiry. Blank means log-only. Format is text
# (ntfy.sh), slack, or discord.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=text

# Backups (scripts/backup.sh). Every daily run keeps its newest RETAIN_LOCAL_DAILY
# database dumps and uploads archives in /var/backups/$APP_NAME/daily. To also push
# them to an S3-compatible bucket via rclone, create the bucket and an access key,
# fill in SPACES_*, and run scripts/install-backup.sh; RETAIN_DAILY, RETAIN_WEEKLY,
# and RETAIN_MONTHLY count the bucket's copies.
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
BACKUP_PREFIX=prod
RETAIN_DAILY=14
RETAIN_WEEKLY=8
RETAIN_MONTHLY=6
RETAIN_LOCAL_DAILY=7
# Compose override scripts/backup.sh loads over docker-compose.yml; blank means
# docker/docker-compose.prod.yml. backup.sh --compose-file wins over it.
BACKUP_COMPOSE_FILE=
